rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == 'FOuQD7ivuuVAfDZwlsjaU2Lte753'
        && request.auth.token.email == 'finho60@hotmail.com';
    }

    function isWaiterFor(waiterId) {
      let waiterPath = /databases/$(database)/documents/waiters/$(waiterId);
      return signedIn()
        && request.auth.token.email_verified == true
        && waiterId is string
        && exists(waiterPath)
        && get(waiterPath).data.active == true
        && get(waiterPath).data.uid == request.auth.uid
        && get(waiterPath).data.email == request.auth.token.email;
    }

    function validWaiterClaim() {
      return signedIn()
        && request.auth.token.email_verified == true
        && resource.data.active == true
        && resource.data.uid == ''
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email']);
    }

    function validCustomerOrder() {
      let data = request.resource.data;
      let directoryPath = /databases/$(database)/documents/waiterDirectory/$(data.waiterId);
      return data.keys().hasAll(['tableNumber', 'status', 'source', 'items', 'total', 'createdAt'])
        && data.keys().hasOnly(['tableNumber', 'waiterId', 'status', 'source', 'items', 'total', 'createdAt'])
        && data.tableNumber is int
        && data.tableNumber > 0
        && data.status == 'novo'
        && data.source == 'qrcode'
        && data.items is list
        && data.total is number
        && data.createdAt is timestamp
        && (!('waiterId' in data)
          || (data.waiterId is string
            && exists(directoryPath)
            && get(directoryPath).data.active == true));
    }

    function validServiceRequest() {
      let data = request.resource.data;
      let directoryPath = /databases/$(database)/documents/waiterDirectory/$(data.waiterId);
      return data.keys().hasAll(['tableNumber', 'type', 'waiterId', 'waiterName', 'status', 'createdAt'])
        && data.keys().hasOnly(['tableNumber', 'type', 'waiterId', 'waiterName', 'status', 'createdAt'])
        && data.tableNumber is int
        && data.tableNumber > 0
        && (data.type == 'waiter' || data.type == 'bill')
        && data.waiterId is string
        && exists(directoryPath)
        && get(directoryPath).data.active == true
        && get(directoryPath).data.name == data.waiterName
        && data.status == 'pending'
        && data.createdAt is timestamp;
    }

    function validWaiterAssignment() {
      let data = request.resource.data;
      let directoryPath = /databases/$(database)/documents/waiterDirectory/$(data.waiterId);
      return data.keys().hasAll(['tableNumber', 'waiterId', 'waiterName', 'updatedAt'])
        && data.keys().hasOnly(['tableNumber', 'waiterId', 'waiterName', 'updatedAt'])
        && data.tableNumber is int
        && data.tableNumber > 0
        && data.waiterId is string
        && exists(directoryPath)
        && get(directoryPath).data.active == true
        && get(directoryPath).data.name == data.waiterName
        && data.updatedAt is timestamp;
    }

    function validTableCallUpdate() {
      return isWaiterFor(resource.data.waiterId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'attendedBy', 'completedAt'])
        && request.resource.data.attendedBy is string
        && ((resource.data.status == 'pending' && request.resource.data.status == 'in_progress')
          || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed'))
        && (request.resource.data.status != 'completed' || request.resource.data.completedAt is timestamp);
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /restaurants/{restaurantId} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == restaurantId);
      allow list: if isOwner() || signedIn();
      allow create: if isOwner();
      allow update: if isOwner() || (signedIn() && request.auth.uid == restaurantId);
      allow delete: if isOwner();
    }

    match /waiterDirectory/{waiterId} {
      allow get, list: if isOwner() || resource.data.active == true;
      allow write: if isOwner();
    }

    match /waiters/{waiterId} {
      allow get: if isOwner() || isWaiterFor(waiterId);
      allow list: if isOwner() || (
        signedIn()
        && request.auth.token.email_verified == true
        && resource.data.active == true
        && resource.data.uid == request.auth.uid
      );
      allow create, delete: if isOwner();
      allow update: if isOwner() || validWaiterClaim();
    }

    match /waiterTables/{tableNumber} {
      allow get: if true;
      allow list: if isOwner();
      allow create, update: if isOwner() || (request.auth == null && validWaiterAssignment());
      allow delete: if isOwner();
    }

    match /tables/{tableId} {
      allow read: if isOwner();
      allow list: if isOwner();
      allow create, update, delete: if isOwner();
    }

    match /orders/{orderId} {
      allow create: if isOwner() || (request.auth == null && validCustomerOrder());
      allow read: if isOwner() || isWaiterFor(resource.data.waiterId);
      allow update, delete: if isOwner();
    }

    match /tableCalls/{callId} {
      allow read: if isOwner() || isWaiterFor(resource.data.waiterId);
      allow create: if isOwner() || (request.auth == null && validServiceRequest());
      allow update: if isOwner() || validTableCallUpdate();
      allow delete: if isOwner();
    }

    match /billRequests/{requestId} {
      allow read: if isOwner() || isWaiterFor(resource.data.waiterId);
      allow create: if isOwner() || (request.auth == null && validServiceRequest());
      allow update: if isOwner() || validTableCallUpdate();
      allow delete: if isOwner();
    }

    match /payments/{paymentId} {
      allow read: if isOwner();
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['tableNumber', 'method', 'amount', 'items', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['tableNumber', 'method', 'amount', 'items', 'status', 'createdAt'])
        && request.resource.data.tableNumber is int
        && request.resource.data.amount is number
        && request.resource.data.items is int
        && request.resource.data.status == 'completed'
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /tableReleases/{releaseId} {
      allow read: if isOwner();
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['tableNumber', 'totalAmount', 'paymentMethod', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['tableNumber', 'totalAmount', 'paymentMethod', 'status', 'createdAt'])
        && request.resource.data.tableNumber is int
        && request.resource.data.totalAmount is number
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
