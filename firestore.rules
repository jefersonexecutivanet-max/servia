rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ATENÇÃO: Valores hardcoded aqui. Atualize se o owner mudar.
    // Para usar valores do ambiente, o frontend usa VITE_OWNER_UID e VITE_OWNER_EMAIL.
    function isOwner() {
      return signedIn()
        && request.auth.uid == 'FOuQD7ivuuVAfDZwlsjaU2Lte753'
        && request.auth.token.email == 'finho60@hotmail.com';
    }

    function isActiveRestaurantOwner(restaurantId) {
      let restaurantPath = /databases/$(database)/documents/restaurants/$(restaurantId);
      return signedIn()
        && request.auth.uid == restaurantId
        && exists(restaurantPath)
        && get(restaurantPath).data.ownerEmail == request.auth.token.email
        && get(restaurantPath).data.status == 'active'
        && get(restaurantPath).data.monthlyPaidUntil is timestamp
        && get(restaurantPath).data.monthlyPaidUntil > request.time;
    }

    function isActiveTeamMemberForRestaurant(restaurantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/restaurantStaff/$(request.auth.uid))
        && get(/databases/$(database)/documents/restaurantStaff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/restaurantStaff/$(request.auth.uid)).data.restaurantId == restaurantId;
    }

    function validOwnTeamAccess(staffUid) {
      let waiterPath = /databases/$(database)/documents/waiters/$(request.resource.data.waiterId);
      return signedIn()
        && staffUid == request.auth.uid
        && request.resource.data.keys().hasAll(['restaurantId', 'waiterId', 'active'])
        && request.resource.data.keys().hasOnly(['restaurantId', 'waiterId', 'active', 'role'])
        && request.resource.data.active == true
        && exists(waiterPath)
        && get(waiterPath).data.uid == request.auth.uid
        && get(waiterPath).data.active == true
        && get(waiterPath).data.restaurantId == request.resource.data.restaurantId
        && (!('role' in request.resource.data) || request.resource.data.role == get(waiterPath).data.role);
    }

    function canManageRestaurant(restaurantId) {
      return isOwner() || isActiveRestaurantOwner(restaurantId);
    }

    function isStaffRoleForRestaurant(restaurantId, expectedRole) {
      let staffPath = /databases/$(database)/documents/restaurantStaff/$(request.auth.uid);
      let waiterPath = /databases/$(database)/documents/waiters/$(get(staffPath).data.waiterId);
      let role = ('role' in get(staffPath).data) ? get(staffPath).data.role : get(waiterPath).data.role;
      return signedIn()
        && exists(staffPath)
        && get(staffPath).data.active == true
        && get(staffPath).data.restaurantId == restaurantId
        && (role == expectedRole
          || (expectedRole == 'WAITER' && role in ['Garçom', 'Garçonete', 'Funcionário'])
          || (expectedRole == 'FLOOR_MANAGER' && role == 'Chefe de salão'));
    }

    function isRestaurantManager(restaurantId) {
      return canManageRestaurant(restaurantId) || isStaffRoleForRestaurant(restaurantId, 'MANAGER');
    }

    function isFloorManager(restaurantId) {
      return isRestaurantManager(restaurantId) || isStaffRoleForRestaurant(restaurantId, 'FLOOR_MANAGER');
    }

    function isCashier(restaurantId) {
      return canManageRestaurant(restaurantId) || isStaffRoleForRestaurant(restaurantId, 'CASHIER');
    }

    function isKitchen(restaurantId) {
      return isStaffRoleForRestaurant(restaurantId, 'KITCHEN');
    }

    function canManageEmployees(restaurantId) {
      return canManageRestaurant(restaurantId) || isStaffRoleForRestaurant(restaurantId, 'MANAGER');
    }

    function validKitchenOrderUpdate() {
      return isKitchen(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'novo' && request.resource.data.status == 'preparando')
          || (resource.data.status == 'preparando' && request.resource.data.status == 'pronto'));
    }

    function validLeadOrderUpdate() {
      return isFloorManager(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['preparando', 'pronto', 'entregue', 'cancelado'];
    }

    function validCashierOrderClose() {
      return isCashier(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.paymentStatus == 'paid'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentId', 'paidAt']);
    }

    function validFloorTableUpdate() {
      return isFloorManager(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'guests', 'total', 'customer', 'x', 'y']);
    }

    function isActiveWaiterForRestaurant(waiterId, restaurantId) {
      let waiterPath = /databases/$(database)/documents/waiterDirectory/$(waiterId);
      return waiterId is string
        && exists(waiterPath)
        && get(waiterPath).data.active == true
        && get(waiterPath).data.restaurantId == restaurantId;
    }

    function isWaiterFor(waiterId) {
      let waiterPath = /databases/$(database)/documents/waiters/$(waiterId);
      return signedIn()
        && waiterId is string
        && exists(waiterPath)
        && get(waiterPath).data.active == true
        && get(waiterPath).data.uid == request.auth.uid
        && get(waiterPath).data.email == request.auth.token.email;
    }

    function validWaiterClaim() {
      return signedIn()
        && resource.data.active == true
        && resource.data.uid == ''
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'email']);
    }

    function validWaiterPasswordChange() {
      return signedIn()
        && resource.data.active == true
        && resource.data.uid == request.auth.uid
        && resource.data.email == request.auth.token.email
        && resource.data.mustChangePassword == true
        && request.resource.data.mustChangePassword == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']);
    }

    function isWaiterAssignedToTable(restaurantId, tableId) {
      return signedIn()
        && exists(/databases/$(database)/documents/restaurantStaff/$(request.auth.uid))
        && get(/databases/$(database)/documents/restaurantStaff/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/restaurantStaff/$(request.auth.uid)).data.restaurantId == restaurantId
        && exists(/databases/$(database)/documents/waiterTables/$(tableId))
        && get(/databases/$(database)/documents/waiterTables/$(tableId)).data.restaurantId == restaurantId
        && get(/databases/$(database)/documents/waiterTables/$(tableId)).data.waiterId
          == get(/databases/$(database)/documents/restaurantStaff/$(request.auth.uid)).data.waiterId;
    }

    function validWaiterOrderDelivery() {
      return isStaffRoleForRestaurant(resource.data.restaurantId, 'WAITER')
        && isWaiterAssignedToTable(resource.data.restaurantId, resource.data.tableId)
        && resource.data.status == 'pronto'
        && request.resource.data.status == 'entregue'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    function validCustomerOrder() {
      let data = request.resource.data;
      let tablePath = /databases/$(database)/documents/tables/$(data.tableId);
      return data.keys().hasAll(['restaurantId', 'tableId', 'tableNumber', 'status', 'source', 'items', 'total', 'createdAt'])
        && data.keys().hasOnly(['restaurantId', 'tableId', 'tableNumber', 'waiterId', 'status', 'source', 'items', 'total', 'createdAt'])
        && data.restaurantId is string
        && data.restaurantId.size() > 0
        && data.tableNumber is int
        && data.tableId is string
        && data.tableNumber > 0
        && data.status == 'novo'
        && data.source == 'qrcode'
        && data.items is list
        && data.total is number
        && data.createdAt is timestamp
        && exists(tablePath)
        && get(tablePath).data.restaurantId == data.restaurantId
        && get(tablePath).data.number == data.tableNumber
        && (!('waiterId' in data) || isActiveWaiterForRestaurant(data.waiterId, data.restaurantId));
    }

    function validServiceRequest() {
      let data = request.resource.data;
      let directoryPath = /databases/$(database)/documents/waiterDirectory/$(data.waiterId);
      let tablePath = /databases/$(database)/documents/tables/$(data.tableId);
      return data.keys().hasAll(['restaurantId', 'tableId', 'tableNumber', 'type', 'waiterId', 'waiterName', 'status', 'createdAt'])
        && data.keys().hasOnly(['restaurantId', 'tableId', 'tableNumber', 'type', 'waiterId', 'waiterName', 'status', 'createdAt'])
        && data.restaurantId is string
        && data.tableId is string
        && data.tableNumber is int
        && data.tableNumber > 0
        && (data.type == 'waiter' || data.type == 'bill')
        && data.waiterId is string
        && exists(directoryPath)
        && get(directoryPath).data.active == true
        && get(directoryPath).data.restaurantId == data.restaurantId
        && exists(tablePath)
        && get(tablePath).data.restaurantId == data.restaurantId
        && get(tablePath).data.number == data.tableNumber
        && get(directoryPath).data.name == data.waiterName
        && data.status == 'pending'
        && data.createdAt is timestamp;
    }

    function validWaiterAssignment() {
      let data = request.resource.data;
      let directoryPath = /databases/$(database)/documents/waiterDirectory/$(data.waiterId);
      let tablePath = /databases/$(database)/documents/tables/$(data.tableId);
      return data.keys().hasAll(['restaurantId', 'tableId', 'tableNumber', 'waiterId', 'waiterName', 'updatedAt'])
        && data.keys().hasOnly(['restaurantId', 'tableId', 'tableNumber', 'waiterId', 'waiterName', 'updatedAt'])
        && data.restaurantId is string
        && data.tableId is string
        && data.tableNumber is int
        && data.tableNumber > 0
        && data.waiterId is string
        && exists(directoryPath)
        && get(directoryPath).data.active == true
        && get(directoryPath).data.restaurantId == data.restaurantId
        && exists(tablePath)
        && get(tablePath).data.restaurantId == data.restaurantId
        && get(tablePath).data.number == data.tableNumber
        && get(directoryPath).data.name == data.waiterName
        && (!signedIn() || isFloorManager(data.restaurantId)
          || (isStaffRoleForRestaurant(data.restaurantId, 'WAITER')
            && get(/databases/$(database)/documents/restaurantStaff/$(request.auth.uid)).data.waiterId == data.waiterId))
        && data.updatedAt is timestamp;
    }

    function validTableCallUpdate() {
      return isWaiterFor(resource.data.waiterId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'attendedBy', 'completedAt'])
        && request.resource.data.attendedBy is string
        && ((resource.data.status == 'pending' && request.resource.data.status == 'in_progress')
          || (resource.data.status == 'in_progress' && request.resource.data.status == 'completed'))
        && (request.resource.data.status != 'completed' || request.resource.data.completedAt is timestamp);
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow create: if isOwner() || isRestaurantManager(request.resource.data.restaurantId);
      allow update: if isOwner() || (isRestaurantManager(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId);
      allow delete: if isOwner() || isRestaurantManager(resource.data.restaurantId);
    }

    match /restaurants/{restaurantId} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == restaurantId);
      allow list: if isOwner();
      allow create: if isOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /waiterDirectory/{waiterId} {
      allow get, list: if isOwner() || resource.data.active == true;
      allow create: if isOwner() || canManageEmployees(request.resource.data.restaurantId);
      allow update: if isOwner() || (
        canManageEmployees(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
      );
      allow delete: if isOwner() || canManageEmployees(resource.data.restaurantId);
    }

    match /waiters/{waiterId} {
      allow get: if isOwner() || isWaiterFor(waiterId)
        || isRestaurantManager(resource.data.restaurantId) || isFloorManager(resource.data.restaurantId);
      allow list: if isOwner()
        || isRestaurantManager(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId)
        || (
          signedIn()
          && resource.data.active == true
          && resource.data.uid == request.auth.uid
        );
      allow create: if isOwner() || canManageEmployees(request.resource.data.restaurantId);
      allow delete: if isOwner() || canManageEmployees(resource.data.restaurantId);
      allow update: if isOwner() || (
        canManageEmployees(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
      ) || validWaiterClaim() || validWaiterPasswordChange();
    }

    match /restaurantStaff/{staffUid} {
      allow get: if isOwner() || (signedIn() && staffUid == request.auth.uid);
      allow list: if isOwner();
      allow create: if isOwner()
        || canManageEmployees(request.resource.data.restaurantId)
        || validOwnTeamAccess(staffUid);
      allow update: if isOwner() || (
        canManageEmployees(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
      ) || validOwnTeamAccess(staffUid);
      allow delete: if isOwner() || canManageEmployees(resource.data.restaurantId);
    }

    match /waiterTables/{tableNumber} {
      allow get: if true;
      allow list: if isOwner()
        || isActiveRestaurantOwner(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId)
        || isWaiterFor(resource.data.waiterId);
      allow create, update: if isOwner() || isFloorManager(request.resource.data.restaurantId) || validWaiterAssignment();
      allow delete: if isOwner() || isFloorManager(resource.data.restaurantId);
    }

    match /tables/{tableId} {
      allow read: if isOwner()
        || isActiveRestaurantOwner(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId)
        || isCashier(resource.data.restaurantId)
        || isStaffRoleForRestaurant(resource.data.restaurantId, 'WAITER')
        || isWaiterFor(resource.data.waiterId);
      allow list: if isOwner()
        || isActiveRestaurantOwner(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId)
        || isCashier(resource.data.restaurantId)
        || isStaffRoleForRestaurant(resource.data.restaurantId, 'WAITER')
        || isWaiterFor(resource.data.waiterId);
      allow create: if isRestaurantManager(request.resource.data.restaurantId);
      allow update: if (isRestaurantManager(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId) || validFloorTableUpdate();
      allow delete: if isRestaurantManager(resource.data.restaurantId);
    }

    match /orders/{orderId} {
      allow create: if isOwner() || isRestaurantManager(request.resource.data.restaurantId)
        || isFloorManager(request.resource.data.restaurantId) || validCustomerOrder();
      allow read: if isOwner()
        || isActiveRestaurantOwner(resource.data.restaurantId)
        || isRestaurantManager(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId)
        || isCashier(resource.data.restaurantId)
        || isKitchen(resource.data.restaurantId)
        || (isWaiterFor(resource.data.waiterId)
          && isStaffRoleForRestaurant(resource.data.restaurantId, 'WAITER'));
      allow update: if (isRestaurantManager(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId)
        || validLeadOrderUpdate() || validKitchenOrderUpdate()
        || validCashierOrderClose() || validWaiterOrderDelivery();
      allow delete: if isRestaurantManager(resource.data.restaurantId);
    }

    match /stock/{stockItemId} {
      allow read: if isOwner() || isRestaurantManager(resource.data.restaurantId);
      allow create: if isRestaurantManager(request.resource.data.restaurantId)
        && request.resource.data.keys().hasOnly(['restaurantId', 'name', 'category', 'quantity', 'unit', 'minQuantity', 'price', 'lastUpdated'])
        && request.resource.data.name is string && request.resource.data.quantity is number && request.resource.data.quantity >= 0;
      allow update: if isRestaurantManager(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.keys().hasOnly(['restaurantId', 'name', 'category', 'quantity', 'unit', 'minQuantity', 'price', 'lastUpdated'])
        && request.resource.data.quantity is number && request.resource.data.quantity >= 0;
      allow delete: if isRestaurantManager(resource.data.restaurantId);
    }
    match /cashTransactions/{transactionId} {
      allow read: if isOwner() || isCashier(resource.data.restaurantId);
      allow create: if isCashier(request.resource.data.restaurantId)
        && request.resource.data.keys().hasOnly(['restaurantId', 'type', 'category', 'description', 'amount', 'paymentMethod', 'reference', 'createdAt'])
        && (request.resource.data.type == 'entrada' || request.resource.data.type == 'saida')
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.description is string && request.resource.data.createdAt is timestamp;
      allow update: if isCashier(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.keys().hasOnly(['restaurantId', 'type', 'category', 'description', 'amount', 'paymentMethod', 'reference', 'createdAt'])
        && (request.resource.data.type == 'entrada' || request.resource.data.type == 'saida')
        && request.resource.data.amount is number && request.resource.data.amount > 0;
      allow delete: if isCashier(resource.data.restaurantId);
    }
    match /tableCalls/{callId} {
      allow read: if isOwner() || isRestaurantManager(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId) || isWaiterFor(resource.data.waiterId);
      allow create: if isOwner() || validServiceRequest();
      allow update: if isOwner() || isRestaurantManager(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId) || validTableCallUpdate();
      allow delete: if isOwner() || isRestaurantManager(resource.data.restaurantId);
    }
    match /billRequests/{requestId} {
      allow read: if isOwner() || isRestaurantManager(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId) || isWaiterFor(resource.data.waiterId);
      allow create: if isOwner() || validServiceRequest();
      allow update: if isOwner() || isRestaurantManager(resource.data.restaurantId)
        || isFloorManager(resource.data.restaurantId) || validTableCallUpdate();
      allow delete: if isOwner() || isRestaurantManager(resource.data.restaurantId);
    }
    match /payments/{paymentId} {
      allow read: if isOwner() || isCashier(resource.data.restaurantId)
        || isRestaurantManager(resource.data.restaurantId);
      allow create: if isCashier(request.resource.data.restaurantId)
        && request.resource.data.keys().hasAll(['restaurantId', 'tableId', 'tableNumber', 'method', 'amount', 'items', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['restaurantId', 'tableId', 'tableNumber', 'method', 'amount', 'items', 'status', 'createdAt'])
        && request.resource.data.restaurantId is string && request.resource.data.tableId is string
        && request.resource.data.tableNumber is int && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.items is int && request.resource.data.items >= 0
        && request.resource.data.status == 'completed' && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/tables/$(request.resource.data.tableId))
        && get(/databases/$(database)/documents/tables/$(request.resource.data.tableId)).data.restaurantId == request.resource.data.restaurantId
        && get(/databases/$(database)/documents/tables/$(request.resource.data.tableId)).data.number == request.resource.data.tableNumber;
      allow update: if isCashier(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if isCashier(resource.data.restaurantId);
    }
    match /tableReleases/{releaseId} {
      allow read: if isOwner() || isFloorManager(resource.data.restaurantId) || isCashier(resource.data.restaurantId);
      allow create: if request.auth == null
        && request.resource.data.keys().hasAll(['restaurantId', 'tableId', 'tableNumber', 'totalAmount', 'paymentMethod', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['restaurantId', 'tableId', 'tableNumber', 'totalAmount', 'paymentMethod', 'status', 'createdAt'])
        && request.resource.data.restaurantId is string && request.resource.data.tableNumber is int
        && request.resource.data.totalAmount is number && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp && request.resource.data.tableId is string
        && exists(/databases/$(database)/documents/tables/$(request.resource.data.tableId))
        && get(/databases/$(database)/documents/tables/$(request.resource.data.tableId)).data.restaurantId == request.resource.data.restaurantId
        && get(/databases/$(database)/documents/tables/$(request.resource.data.tableId)).data.number == request.resource.data.tableNumber;
      allow update: if isCashier(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if isCashier(resource.data.restaurantId);
    }
  }
}
